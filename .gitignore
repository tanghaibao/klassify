# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Rendered output from docs/animation/build.sh (the GIF is checked in, the rest is not)
docs/animation/media/
docs/animation/*.mp4
__pycache__/
